INTENT_IMAGE=your-namespace/intent-crm:0.4.0
INTENT_BIND_IP=127.0.0.1
INTENT_HTTP_PORT=3100
# Create once for a NEW install. For existing data, use its real volume, user and database.
# Changing these names does not rename the database objects already stored in that volume.
INTENT_POSTGRES_VOLUME=intent-crm-production_intent-postgres
POSTGRES_USER=intent_app
POSTGRES_DB=intent_crm
# Replace both placeholders consistently. Use a URL-safe random password,
# or percent-encode the password component of DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://intent_app:REPLACE_WITH_RANDOM_DATABASE_PASSWORD@postgres:5432/intent_crm
INTENT_PUBLIC_ORIGIN=https://crm.example.com
# Explicit proxy IPs/CIDRs only. Blank ignores forwarding headers for client identity.
INTENT_TRUSTED_PROXIES=
# A protected production Temporal service reachable FROM containers.
# localhost here refers to the container, not the host.
TEMPORAL_ADDRESS=temporal.internal.example:7233
TEMPORAL_NAMESPACE=default

# The same protected Base64-encoded random 32-byte key must reach API and worker.
# Blank keeps external credential configuration unavailable.
INTENT_ENCRYPTION_KEY=
# Approved public hostnames, comma-separated. No scheme or path.
INTENT_MODEL_ALLOWED_HOSTS=
INTENT_DELIVERY_ALLOWED_HOSTS=
