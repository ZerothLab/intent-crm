# Local development starts with a Fixture demo model and simulated delivery.
POSTGRES_USER=intent_local
POSTGRES_DB=intent_crm
POSTGRES_PASSWORD=intent_dev_only
# Create this volume once for a new install; reuse the actual old name for existing data.
INTENT_POSTGRES_VOLUME=intent-crm_intent-postgres
DATABASE_URL=postgresql://intent_local:intent_dev_only@127.0.0.1:54329/intent_crm
HOST=127.0.0.1
API_PORT=3100
NODE_ENV=development
INTENT_AUTH_MODE=development
INTENT_DEV_AUTH=true
# For real accounts in local development, change AUTH_MODE to password and set:
# INTENT_PUBLIC_ORIGIN=http://127.0.0.1:5173
# Leave blank unless an explicitly trusted reverse proxy supplies client addresses.
INTENT_TRUSTED_PROXIES=
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
INTENT_TRANSPORT_OUTCOME=success

# Required before saving external provider or delivery credentials. Generate securely.
INTENT_ENCRYPTION_KEY=
# Exact public hostnames, comma-separated. DeepSeek is approved by default.
INTENT_MODEL_ALLOWED_HOSTS=
INTENT_DELIVERY_ALLOWED_HOSTS=
